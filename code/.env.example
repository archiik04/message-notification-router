# Sentinel runs fully without any of these. Copy to .env only if you want the
# optional layers. Never commit a filled-in .env - it is gitignored.

# ---------------------------------------------------------------------------
# Optional LLM arbitration.
#
# Measured on this dataset as a NET NEGATIVE (see code/README.md), so it is off
# by default. Setting this key enables it for gray-zone rows only; the safety
# engine still holds an absolute veto over anything the model says.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # for an OpenAI-compatible proxy

# ---------------------------------------------------------------------------
# OCR binary location.
#
# Only needed if tesseract is neither on PATH nor in a standard install
# directory. The code probes both before giving up.
# ---------------------------------------------------------------------------
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
